// File name: projects/1/Mux8Way16.hdl
/**
 * 8-way 16-bit multiplexor:
 * out = a if sel = 000
 *       b if sel = 001
 *       c if sel = 010
 *       d if sel = 011
 *       e if sel = 100
 *       f if sel = 101
 *       g if sel = 110
 *       h if sel = 111
 */
CHIP Mux8Way16 {
    IN a[16], b[16], c[16], d[16],
       e[16], f[16], g[16], h[16],
       sel[3];
    OUT out[16];

    PARTS:
    //// Replace this comment with your code.
    Mux16(a=a , b=b , sel=sel[0] , out=outMux1);
    Mux16(a=c , b=d , sel=sel[0] , out=outMux2);
    Mux16(a=e , b=f , sel=sel[0] , out=outMux3);
    Mux16(a=g , b=h , sel=sel[0] , out=outMux4);
    Mux16(a=outMux1 , b=outMux2 , sel=sel[1] , out=outMux5 );
    Mux16(a=outMux3 , b=outMux4 , sel=sel[1] , out=outMux6 );
    Mux16(a=outMux5 , b=outMux6 , sel=sel[2] , out=out);
}